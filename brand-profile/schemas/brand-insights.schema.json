{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrandInsights",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brand_id"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "brand_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "audience_insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience", "provenance"],
        "properties": {
          "audience": {"type": "string", "minLength": 1},
          "product_ids": {"$ref": "#/$defs/product_ids"},
          "pain_points": {"$ref": "#/$defs/phrases"},
          "scenarios": {"$ref": "#/$defs/phrases"},
          "objections": {"$ref": "#/$defs/phrases"},
          "native_phrases": {"$ref": "#/$defs/phrases"},
          "provenance": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "content_pillars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pillar", "provenance"],
        "properties": {
          "pillar": {"type": "string", "minLength": 1},
          "product_ids": {"$ref": "#/$defs/product_ids"},
          "angles": {"$ref": "#/$defs/phrases"},
          "audiences": {"$ref": "#/$defs/phrases"},
          "provenance": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "differentiation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vs", "point", "evidence", "provenance"],
        "properties": {
          "vs": {"type": "string", "minLength": 1},
          "point": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "product_ids": {"$ref": "#/$defs/product_ids"},
          "provenance": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "language_bank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice_samples": {"$ref": "#/$defs/phrases"},
        "hook_patterns": {"$ref": "#/$defs/phrases"},
        "avoid_patterns": {"$ref": "#/$defs/phrases"}
      }
    }
  },
  "$defs": {
    "phrases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "product_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "observed_count", "first_seen", "last_seen", "confidence"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["interview", "local_asset", "platform_radar"]}
        },
        "observed_count": {"type": "integer", "minimum": 1},
        "first_seen": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "last_seen": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "confidence": {"enum": ["low", "medium", "high"]},
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "observed_at"],
            "properties": {
              "source": {"enum": ["interview", "local_asset", "platform_radar"]},
              "observed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "ref": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "run_id": {"type": "string", "minLength": 1},
                  "note_urls": {"type": "array", "items": {"type": "string", "minLength": 1}},
                  "note": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
