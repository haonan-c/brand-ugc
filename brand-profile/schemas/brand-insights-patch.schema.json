{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrandInsightsPatch",
  "description": "一次采集产出的洞察补丁。来源和观察时间在顶层声明一次，条目不携带 provenance，由 insights-merge 计算。",
  "type": "object",
  "additionalProperties": false,
  "required": ["brand_id", "source"],
  "properties": {
    "brand_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source": {"enum": ["interview", "local_asset", "platform_radar"]},
    "observed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "note_urls": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "audience_insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audience"],
        "properties": {
          "audience": {"type": "string", "minLength": 1},
          "product_ids": {"$ref": "#/$defs/product_ids"},
          "pain_points": {"$ref": "#/$defs/phrases"},
          "scenarios": {"$ref": "#/$defs/phrases"},
          "objections": {"$ref": "#/$defs/phrases"},
          "native_phrases": {"$ref": "#/$defs/phrases"}
        }
      }
    },
    "content_pillars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pillar"],
        "properties": {
          "pillar": {"type": "string", "minLength": 1},
          "product_ids": {"$ref": "#/$defs/product_ids"},
          "angles": {"$ref": "#/$defs/phrases"},
          "audiences": {"$ref": "#/$defs/phrases"}
        }
      }
    },
    "differentiation": {
      "description": "只允许 interview 和 local_asset 来源；平台回流不能生成差异化主张。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vs", "point", "evidence"],
        "properties": {
          "vs": {"type": "string", "minLength": 1},
          "point": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "product_ids": {"$ref": "#/$defs/product_ids"}
        }
      }
    },
    "language_bank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice_samples": {"$ref": "#/$defs/phrases"},
        "hook_patterns": {"$ref": "#/$defs/phrases"},
        "title_formulas": {"$ref": "#/$defs/title_formulas"},
        "avoid_patterns": {"$ref": "#/$defs/phrases"}
      }
    }
  },
  "$defs": {
    "phrases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "title_formulas": {
      "description": "受控标题公式，与 xhs-topic-radar 策略卡的 titlePattern 取值一致。",
      "type": "array",
      "items": {
        "enum": ["number", "question", "pain-point", "result", "urgency", "authority"]
      }
    },
    "product_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    }
  }
}
